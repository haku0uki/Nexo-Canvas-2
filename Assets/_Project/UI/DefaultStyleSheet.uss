.comment-entry {
    flex-grow: 1;
    background-color: rgb(181, 175, 69);
    margin-left: 25px;
    margin-right: 25px;
    margin-bottom: 10px;
    margin-top: 5px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 0;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 0;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.user-label {
    font-size: 300%;
}

.text-label {
    font-size: 210%;
    white-space: normal;
}

.separator {
    flex-grow: 0;
    height: 0.5%;
    background-color: rgb(0, 0, 0);
}
