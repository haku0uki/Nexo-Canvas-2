:root {
    --color-accent: rgb(181, 175, 69);
}

.unity-button {
    scale: 1 1;
    transition-duration: 0.2s;
}

.unity-button:hover {
    scale: 1.1 1.1 1.1;
}

.unity-button:active {
    scale: 0.9 0.9 0.9;
    transition-duration: 0.1s;
}

.details-root {
    flex-grow: 1;
}

.details-background {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-image: url("project://database/Assets/_Project/2D/Fondo_nexo_canvas.png?fileID=2800000&guid=974d1778c201b884ea9a35525b90d664&type=3#Fondo_nexo_canvas");
    -unity-background-image-tint-color: rgb(96, 96, 96);
    filter: blur(1) opacity(0.5);
}

.details-spacer {
    flex-shrink: 0;
    height: 100px;
}

.details-postit {
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 1;
}

.details-comments {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(64, 64, 64, 0);
}

.postit {
    flex-grow: 1;
    aspect-ratio: 1;
}

.post-it-amarillo {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-image: url("project://database/Assets/_Project/2D/post_it_amarillo.png?fileID=2800000&guid=ae5465568c0e1594a9a7133281d5598b&type=3#post_it_amarillo");
}

.postit-content {
    flex-grow: 1;
    margin: 10%;
}

.postit-drawing-view {
    flex-grow: 1;
}

.postit-text-input {
    flex-grow: 1;
    padding-top: 10px;
    padding-left: 10px;
    padding-bottom: 170px;
    font-size: 28px;
    color: rgb(0, 0, 0);
    -unity-text-align: upper-left;
}

.user-label {
    font-size: 300%;
}

.text-label {
    font-size: 210%;
    white-space: normal;
}

.separator {
    height: 4px;
    background-color: rgb(0, 0, 0);
}

.empty-background {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

#postit-text-input #unity-text-input {
    background-color: rgba(0, 0, 0, 0.08);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

.comment-entry {
    flex-grow: 1;
    margin: 5px 25px 10px 25px;
    padding: 10px;
    background-color: var(--color-accent);
    border-radius: 10px;
    border-width: 0 5px 5px 0;
    border-color: rgb(0, 0, 0);
}

.comment-composer {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 150px;
    padding: 10px 25px 15px 25px;
}

.comment-composer.keyboard-open {
    background-color: rgba(0, 0, 0, 0.85);
}

.comment-input {
    flex-grow: 1;
    min-height: 80px;
    margin-right: 10px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgb(0, 0, 0);
}

.publish-button {
    height: 80px;
    padding: 8px 15px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 10px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.back-button {
    position: absolute;
    top: 2%;
    right: 2%;
    min-width: 200px;
    min-height: 200px;
    background-image: url("project://database/Assets/_Project/2D/Boton%20de%20Volver.png?fileID=782665709&guid=0c8e5e92bad81d842b2d59a39c71724c&type=3#Boton de Volver_0");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(188, 188, 188, 0);
    border-width: 0;
}

.back-button:active {
    -unity-background-image-tint-color: rgb(180, 180, 180);
}

.actions-container {
    align-self: center;
    padding-top: 15px;
    padding-bottom: 20px;
}

.image-button {
    flex-shrink: 0;
    align-self: center;
    width: 80%;
    height: 45%;
    margin-top: 15px;
    background-image: none;
    background-color: rgba(188, 188, 188, 0);
    border-width: 0;
}

.draw-entry-drawing-area {
    flex-grow: 1;
    margin-bottom: 123px;
}

.draw-entry-controls {
    position: absolute;
    right: 5%;
    bottom: 3%;
    left: 5%;
    padding: 25px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 25px;
}

.draw-entry-controls .unity-button {
    scale: 1 1;
    transition-duration: 0.15s;
}

.draw-entry-controls .unity-button:hover {
    scale: 1.04 1.04 1.04;
}

.draw-entry-controls .unity-button:active {
    scale: 0.96 0.96 0.96;
    transition-duration: 0.1s;
}

.draw-entry-controls > .publish-button {
    min-height: 90px;
    margin-top: 5px;
    margin-bottom: 10px;
    border-radius: 15px;
    font-size: 32px;
    -unity-text-align: middle-center;
}

.draw-entry-controls > .cancel-button {
    min-height: 70px;
    font-size: 28px;
}

.draw-control-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
}

.draw-control-label {
    width: 150px;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.draw-slider {
    flex-grow: 1;
    min-height: 45px;
}

.color-buttons {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
    margin-bottom: 20px;
}

.draw-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 20px;
}

.draw-button {
    flex-grow: 1;
    min-height: 70px;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 26px;
}

#PasswordField .unity-text-element {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgb(255, 255, 255);
}

#PasswordField #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgba(255, 255, 255, 0);
}

#EmailField .unity-text-element {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgb(255, 255, 255);
}

#EmailField #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgba(255, 255, 255, 0);
}
