.comment-entry {
    flex-grow: 1;
    background-color: rgb(181, 175, 69);
    margin-left: 25px;
    margin-right: 25px;
    margin-bottom: 10px;
    margin-top: 5px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 0;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 0;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.user-label {
    font-size: 300%;
}

.text-label {
    font-size: 210%;
    white-space: normal;
}

.separator {
    flex-grow: 0;
    height: 0.5%;
    background-color: rgb(0, 0, 0);
}

.back-button {
    position: absolute;
    background-image: url("project://database/Assets/_Project/2D/Boton%20de%20Volver.png?fileID=782665709&guid=0c8e5e92bad81d842b2d59a39c71724c&type=3#Boton de Volver_0");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(188, 188, 188, 0);
    min-width: 200px;
    min-height: 200px;
    top: 5px;
    right: 5px;
}

.post-it-amarillo {
    flex-grow: 1;
    background-image: url("project://database/Assets/_Project/2D/post_it_amarillo.png?fileID=2800000&guid=ae5465568c0e1594a9a7133281d5598b&type=3#post_it_amarillo");
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.comment-composer {
    align-items: center;
    margin-left: 25px;
    margin-right: 25px;
    margin-bottom: 15px;
}

.comment-input {
    flex-grow: 1;
    margin-right: 10px;
}

.publish-button {
    background-color: rgb(181, 175, 69);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-width: 0;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}
