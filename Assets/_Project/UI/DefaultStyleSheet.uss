.comment-entry {
    flex-grow: 1;
    background-color: rgb(181, 175, 69);
    margin-left: 25px;
    margin-right: 25px;
    margin-bottom: 10px;
    margin-top: 5px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 0;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 0;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.user-label {
    font-size: 300%;
}

.text-label {
    font-size: 210%;
    white-space: normal;
}

.separator {
    flex-grow: 0;
    height: 4px;
    background-color: rgb(0, 0, 0);
}

.back-button {
    position: absolute;
    background-image: url("project://database/Assets/_Project/2D/Boton%20de%20Volver.png?fileID=782665709&guid=0c8e5e92bad81d842b2d59a39c71724c&type=3#Boton de Volver_0");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(188, 188, 188, 0);
    min-width: 200px;
    min-height: 200px;
    top: 2%;
    right: 2%;
    transition-duration: 0.2s;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.back-button:hover {
    transition-property: all;
    scale: 1.1 1.1 1.1;
    transition-duration: 0.2s;
}

.back-button:active {
    transition-property: all;
    scale: 0.9 0.9 0.9;
    transition-duration: 0.1s;
    -unity-background-image-tint-color: rgb(180, 180, 180);
}

.post-it-amarillo {
    flex-grow: 1;
    background-image: url("project://database/Assets/_Project/2D/post_it_amarillo.png?fileID=2800000&guid=ae5465568c0e1594a9a7133281d5598b&type=3#post_it_amarillo");
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.comment-composer {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 150px;
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 10px;
    padding-bottom: 15px;
}

.comment-input {
    flex-grow: 1;
    min-height: 80px;
    margin-right: 10px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.publish-button {
    background-color: rgb(181, 175, 69);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-width: 0;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    height: 80px;
    -unity-text-align: middle-right;
}

.unity-button {
    scale: 1 1;
    transition-duration: 0.2s;
}

.unity-button:hover {
    scale: 1.1 1.1 1.1;
    transition-duration: 0.2s;
}

.unity-button:active {
    scale: 0.9 0.9 0.9;
    transition-duration: 0.1s;
}

.details-root {
    flex-grow: 1;
}

.details-spacer {
    flex-shrink: 0;
    height: 100px;
}

.details-postit {
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 1;
}

.details-comments {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(64, 64, 64, 0);
}

.draw-entry-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
}

.draw-entry-root .post-it-amarillo {
    position: absolute;
    width: 900px;
    height: 900px;
    left: 50%;
    top: 4%;
    translate: -50% 0;
}

.draw-entry-drawing-area {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 8%;
    bottom: 43%;
}

.draw-entry-controls {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 3%;
    flex-direction: column;
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 25px;
    padding-bottom: 25px;
    background-color: rgba(255, 255, 255, 0.9);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 25px;
}

.draw-control-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
}

.draw-control-label {
    width: 150px;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.draw-slider {
    flex-grow: 1;
    min-height: 45px;
}

.color-buttons {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
    margin-bottom: 20px;
}

.color-button {
    flex-grow: 1;
    min-height: 70px;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 26px;
}

.draw-actions {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 20px;
}

.action-button {
    flex-grow: 1;
    min-height: 70px;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 26px;
}

.draw-entry-controls .publish-button {
    width: 100%;
    min-height: 90px;
    margin-top: 5px;
    margin-bottom: 10px;
    background-color: rgb(181, 175, 69);
    color: rgb(0, 0, 0);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.draw-entry-controls .cancel-button {
    width: 100%;
    min-height: 70px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.draw-entry-controls .unity-button {
    scale: 1 1;
    transition-duration: 0.15s;
}

.draw-entry-controls .unity-button:hover {
    scale: 1.04 1.04 1.04;
    transition-duration: 0.15s;
}

.draw-entry-controls .unity-button:active {
    scale: 0.96 0.96 0.96;
    transition-duration: 0.1s;
}

#PasswordField .unity-text-element {
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

#PasswordField #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

#EmailField .unity-text-element {
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

#EmailField #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.empty-background {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

#postit-text-input #unity-text-input {
    background-color: rgba(0, 0, 0, 0.08);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}
