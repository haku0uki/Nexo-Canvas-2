<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/DefaultStyleSheet.uss?fileID=7433441132597879392&amp;guid=92f105faae8cdfa41a5bffceba250712&amp;type=3#DefaultStyleSheet"/>
    <ui:VisualElement name="root" class="details-root">
        <ui:VisualElement name="background" class="details-background"/>
        <ui:VisualElement name="spacer" class="details-spacer"/>
        <ui:VisualElement name="postit-container" class="details-postit">
            <ui:VisualElement name="post-it-amarillo" class="post-it-amarillo"/>
            <ui:VisualElement name="elements-container" class="postit-content">
                <ui:Label text="Usuario" name="username-label-postit" class="user-label"/>
                <ui:VisualElement class="separator"/>
                <ui:TextField name="postit-text-input" placeholder-text="Escribe tus pensamientos..." multiline="true" max-length="1400" class="empty-background postit-text-input" style="text-overflow: ellipsis;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="buttons-container" class="actions-container">
            <ui:Button text="" icon-image="project://database/Assets/_Project/2D/Boton%20Confirmar.png?fileID=-1941097173&amp;guid=8ec51c05a90b11c419ed34ddb43ef508&amp;type=3#Boton Confirmar_0" name="confirm-postit-button" class="image-button"/>
            <ui:Button text="" icon-image="project://database/Assets/_Project/2D/Boton%20Cancelar.png?fileID=-1312338684&amp;guid=93f7ddbbfd19f5d498f08a4fa517e253&amp;type=3#Boton Cancelar_0" name="cancel-postit-button" class="image-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
