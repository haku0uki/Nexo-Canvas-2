<?xml version="1.0" encoding="utf-8"?>

<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False"
>

    <Style src="project://database/Assets/_Project/UI/DefaultStyleSheet.uss?fileID=7433441132597879392&amp;guid=92f105faae8cdfa41a5bffceba250712&amp;type=3#DefaultStyleSheet"/>

    <ui:VisualElement
        name="root"
        class="draw-entry-root"
    >

        <!-- ========================================= -->
        <!-- POST-IT -->
        <!-- ========================================= -->

        <ui:VisualElement
            name="background"
            class="post-it-amarillo"
        />

        <!-- ========================================= -->
        <!-- ÁREA DE DIBUJO -->
        <!-- ========================================= -->

        <ui:VisualElement
            name="drawing-area"
            class="draw-entry-drawing-area"
        />

        <!-- ========================================= -->
        <!-- CONTROLES -->
        <!-- ========================================= -->

        <ui:VisualElement
            name="draw-entry-controls"
            class="draw-entry-controls"
        >

            <!-- GROSOR -->

            <ui:VisualElement
                name="brush-control"
                class="draw-control-row"
            >

                <ui:Label
                    text="Grosor"
                    class="draw-control-label"
                />

                <ui:Slider
                    name="brush-size-slider"
                    low-value="0.01"
                    high-value="0.2"
                    value="0.05"
                    class="draw-slider"
                />

            </ui:VisualElement>


            <!-- GOMA -->

            <ui:VisualElement
                name="eraser-size-control"
                class="draw-control-row"
            >

                <ui:Label
                    text="Goma"
                    class="draw-control-label"
                />

                <ui:Slider
                    name="eraser-size-slider"
                    low-value="0.02"
                    high-value="0.5"
                    value="0.15"
                    class="draw-slider"
                />

            </ui:VisualElement>


            <!-- COLORES -->

            <ui:VisualElement
                name="color-buttons"
                class="color-buttons"
            >

                <ui:Button
                    name="black-color-button"
                    text="Negro"
                    class="color-button"
                />

                <ui:Button
                    name="red-color-button"
                    text="Rojo"
                    class="color-button"
                />

                <ui:Button
                    name="blue-color-button"
                    text="Azul"
                    class="color-button"
                />

                <ui:Button
                    name="green-color-button"
                    text="Verde"
                    class="color-button"
                />

            </ui:VisualElement>


            <!-- ACCIONES -->

            <ui:VisualElement
                name="draw-actions"
                class="draw-actions"
            >

                <ui:Button
                    name="eraser-button"
                    text="Goma"
                    class="action-button"
                />

                <ui:Button
                    name="undo-button"
                    text="Deshacer"
                    class="action-button"
                />

                <ui:Button
                    name="redo-button"
                    text="Rehacer"
                    class="action-button"
                />

            </ui:VisualElement>


            <!-- PUBLICAR -->

            <ui:Button
                name="publish-button"
                text="Publicar"
                class="publish-button"
            />

            <ui:Button
                name="cancel-button"
                text="Cancelar"
                class="cancel-button"
            />

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>