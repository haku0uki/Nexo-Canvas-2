<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/DefaultStyleSheet.uss?fileID=7433441132597879392&amp;guid=92f105faae8cdfa41a5bffceba250712&amp;type=3#DefaultStyleSheet"/>
    <ui:VisualElement name="draw-entry-controls" class="draw-entry-controls" style="margin-top: 8%;">
        <ui:VisualElement name="brush-control" class="draw-control-row">
            <ui:Label text="Grosor" class="draw-control-label"/>
            <ui:Slider name="brush-size-slider" low-value="0.01" high-value="0.2" value="0.05" class="draw-slider"/>
        </ui:VisualElement>
        <ui:VisualElement name="eraser-size-control" class="draw-control-row">
            <ui:Label text="Goma" class="draw-control-label"/>
            <ui:Slider name="eraser-size-slider" low-value="0.02" high-value="0.5" value="0.15" class="draw-slider"/>
        </ui:VisualElement>
        <ui:VisualElement name="color-buttons" class="color-buttons">
            <ui:Button name="black-color-button" text="Negro" class="draw-button"/>
            <ui:Button name="red-color-button" text="Rojo" class="draw-button"/>
            <ui:Button name="blue-color-button" text="Azul" class="draw-button"/>
            <ui:Button name="green-color-button" text="Verde" class="draw-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="draw-actions" class="draw-actions">
            <ui:Button name="eraser-button" text="Goma" class="draw-button"/>
            <ui:Button name="undo-button" text="Deshacer" class="draw-button"/>
            <ui:Button name="redo-button" text="Rehacer" class="draw-button"/>
        </ui:VisualElement>
        <ui:Button name="publish-button" text="Publicar" class="publish-button"/>
        <ui:Button name="cancel-button" text="Cancelar" class="cancel-button"/>
    </ui:VisualElement>
</ui:UXML>
