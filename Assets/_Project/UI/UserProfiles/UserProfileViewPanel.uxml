<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/DefaultStyleSheet.uss?fileID=7433441132597879392&amp;guid=92f105faae8cdfa41a5bffceba250712&amp;type=3#DefaultStyleSheet"/>
    <ui:VisualElement name="root" class="details-root profile-background">
        <ui:VisualElement name="spacer" class="details-spacer profile-spacer"/>
        <ui:ScrollView name="profile-scroll" mode="Vertical" class="profile-scroll">
            <ui:VisualElement name="profile-view-root" class="profile-root">
                <ui:VisualElement name="profile-header" class="profile-header">
                    <ui:VisualElement name="profile-avatar-drawing" class="profile-avatar"/>
                    <ui:VisualElement name="profile-identity" class="profile-identity">
                        <ui:VisualElement name="profile-email-group" class="profile-info-group">
                            <ui:Label name="profile-email-title" text="Correo institucional" class="profile-field-label"/>
                            <ui:Label name="profile-email-label" text="s.usercorreo@uandresbello.edu" class="profile-email"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="profile-nickname-group" class="profile-info-group">
                            <ui:Label name="profile-nickname-title" text="Nombre de usuario" class="profile-field-label"/>
                            <ui:Label name="profile-nickname-label" text="Usuarix" class="profile-nickname"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="profile-pronouns-group" class="profile-info-group">
                            <ui:Label name="profile-pronouns-title" text="Pronombres" class="profile-field-label"/>
                            <ui:Label name="profile-pronouns-label" text="xxxx/xxxx" class="profile-pronouns"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button text="" name="profile-editor" class="profile-pencil-button profile-editor-button"/>
                </ui:VisualElement>
                <ui:Label name="profile-status-label" class="profile-status"/>
                <ui:VisualElement name="profile-separator" class="profile-separator"/>
                <ui:VisualElement name="profile-posts-section" class="profile-posts-section">
                    <ui:VisualElement name="profile-posts-header" class="profile-posts-header">
                        <ui:Label name="profile-posts-title" text="Post-Its publicados" class="profile-section-title"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="profile-posts-list" class="profile-posts-list"/>
                    <ui:VisualElement name="profile-empty-state" class="profile-empty-state">
                        <ui:Label name="profile-empty-label" text="Todavía no hay publicaciones." class="profile-empty-posts"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:Button text="" name="back-button" class="back-button profile-back-button"/>
    </ui:VisualElement>
</ui:UXML>
