<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/DefaultStyleSheet.uss?fileID=7433441132597879392&amp;guid=92f105faae8cdfa41a5bffceba250712&amp;type=3#DefaultStyleSheet"/>
    <ui:VisualElement name="root" class="details-root profile-background" style="background-image: url(&quot;project://database/Assets/_Project/2D/Fondo_nexo_canvas%201.png?fileID=2800000&amp;guid=368716ba14b4ce241832590c6bbe878b&amp;type=3#Fondo_nexo_canvas 1&quot;); -unity-background-image-tint-color: rgba(107, 83, 168, 0.66);">
        <ui:VisualElement name="spacer" class="details-spacer profile-spacer"/>
        <ui:ScrollView name="profile-scroll" mode="Vertical" class="profile-scroll custom-scrollview unity-scroller">
            <ui:VisualElement name="profile-view-root" class="profile-root">
                <ui:VisualElement name="profile-header" class="profile-header">
                    <ui:VisualElement name="profile-avatar-drawing" class="profile-avatar" style="background-color: rgb(254, 245, 195); border-top-width: 21px; border-right-width: 21px; border-bottom-width: 21px; border-left-width: 21px; border-left-color: rgb(12, 7, 22); border-right-color: rgb(12, 7, 22); border-top-color: rgb(12, 7, 22); border-bottom-color: rgb(12, 7, 22); margin-left: 3%;"/>
                    <ui:VisualElement name="profile-identity" class="profile-identity">
                        <ui:VisualElement name="profile-email-group" class="profile-info-group">
                            <ui:Label name="profile-email-title" text="Correo institucional" class="profile-field-label" style="margin-left: -4%; margin-bottom: 2%; color: rgba(35, 48, 57, 0.62);"/>
                            <ui:Label name="profile-email-label" text="s.usercorreo@uandresbello.edu" class="profile-email" style="margin-right: -37%; margin-top: -2%; color: rgba(6, 31, 46, 0.79); padding-bottom: 4%; font-size: 42px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="profile-nickname-group" class="profile-info-group">
                            <ui:Label name="profile-nickname-title" text="Nombre de usuario" class="profile-field-label" style="margin-bottom: -1%; margin-left: -2%; color: rgba(5, 31, 46, 0.62);"/>
                            <ui:Label name="profile-nickname-label" text="Usuarix" class="profile-nickname" style="margin-right: -32%; padding-right: 10%; padding-top: 7%; padding-bottom: 9%; margin-left: -4%; color: rgb(5, 31, 46); padding-left: 8%; font-size: 81px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="profile-pronouns-group" class="profile-info-group">
                            <ui:Label name="profile-pronouns-title" text="Pronombres" class="profile-field-label" style="margin-top: -2%; margin-bottom: 1%; margin-left: -2%; color: rgba(35, 48, 57, 0.62);"/>
                            <ui:Label name="profile-pronouns-label" text="xxxx/xxxx" class="profile-pronouns" style="background-image: url(&quot;project://database/Assets/_Project/2D/Elementos%20Ui%20perfil/Slider%204.png?fileID=21300000&amp;guid=db75fbb0ffb6696439d5ffaabcc6ebe6&amp;type=3#Slider 4&quot;); -unity-background-image-tint-color: rgb(254, 245, 195); margin-right: -33%; margin-left: -26%; padding-left: 26%; padding-bottom: 15%; letter-spacing: -13px; padding-right: 17%; font-size: 56%; color: rgba(5, 31, 46, 0.84); padding-top: 6%;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button text="" name="profile-editor" class="profile-pencil-button profile-editor-button" style="width: 18%; left: -5%; top: 78%;"/>
                </ui:VisualElement>
                <ui:Label name="profile-status-label" class="profile-status"/>
                <ui:VisualElement name="profile-posts-section" class="profile-posts-section" style="margin-bottom: 4%;">
                    <ui:VisualElement name="profile-posts-header" class="profile-posts-header" style="margin-bottom: 4%; padding-bottom: 43px;">
                        <ui:Label name="profile-posts-title" text="Post-Its publicados" picking-mode="Ignore" class="profile-section-title" style="color: rgba(16, 0, 0, 0.82); background-image: url(&quot;project://database/Assets/_Project/2D/Botones%20en%20blanco/Boton%20entrar%20como%20espectador%20horizontal%20en%20blanco.png?fileID=21300000&amp;guid=f23315bc45c09f74184b88705b19772c&amp;type=3#Boton entrar como espectador horizontal en blanco&quot;); width: 110%; height: 369%; top: -107%; -unity-text-align: middle-left; -unity-text-outline-width: 1px; left: -14%; padding-left: 19%; padding-right: 13%; font-size: 64%; padding-bottom: 47px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="profile-posts-list" class="profile-posts-list"/>
                    <ui:VisualElement name="profile-empty-state" class="profile-empty-state">
                        <ui:Label name="profile-empty-label" text="Todavía no hay publicaciones." class="profile-empty-posts"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:Button text="" name="back-button" class="back-button profile-back-button" style="top: 3%; left: 81%;"/>
    </ui:VisualElement>
</ui:UXML>
