<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/DefaultStyleSheet.uss?fileID=7433441132597879392&amp;guid=92f105faae8cdfa41a5bffceba250712&amp;type=3#DefaultStyleSheet"/>
    <ui:VisualElement name="profile-edit-overlay" class="profile-edit-overlay">
        <ui:VisualElement name="profile-edit-window" class="profile-edit-window" style="-unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="profile-edit-header" class="profile-edit-header">
                <ui:Label text="Editar mi perfil" class="profile-edit-title"/>
            </ui:VisualElement>
            <ui:VisualElement name="profile-edit-avatar-row" class="profile-edit-avatar-row">
                <ui:VisualElement name="profile-avatar-drawing" class="profile-edit-avatar" style="border-top-width: 18px; border-right-width: 18px; border-bottom-width: 18px; border-left-width: 18px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); background-color: rgb(255, 245, 195);"/>
                <ui:Button name="profile-change-drawing-button" text="" class="profile-pencil-button profile-change-drawing-button"/>
            </ui:VisualElement>
            <ui:Label text="Nombre de usuario" class="profile-field-label"/>
            <ui:TextField name="profile-nickname-field" max-length="25" class="profile-edit-text-field"/>
            <ui:Label text="Pronombres" class="profile-field-label"/>
            <ui:TextField name="profile-pronouns-field" max-length="15" class="profile-edit-text-field"/>
            <ui:Label name="profile-status-label" text="" class="profile-status"/>
            <ui:VisualElement name="profile-edit-actions" class="profile-edit-actions">
                <ui:Button name="profile-cancel-button" text="" icon-image="project://database/Assets/_Project/2D/Volver.png?fileID=980254898&amp;guid=08758affb683f2d4ba7927ed7398c0b8&amp;type=3#Volver_0" class="profile-cancel-button" style="background-image: none; padding-right: 20px; margin-right: 3%;"/>
                <ui:Button name="profile-save-button" text="Guardar" icon-image="" class="profile-save-button" style="-unity-slice-type: tiled; -unity-slice-left: 1; -unity-slice-top: 1; -unity-slice-right: 1; -unity-slice-bottom: 1; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/_Project/2D/Botones%20en%20blanco/Verde_hor.png?fileID=21300000&amp;guid=efb55e515b00a2a40bbbe195f2ee5d04&amp;type=3#Verde_hor&quot;); font-size: 87%; -unity-text-align: middle-center; padding-bottom: 30px; margin-right: 2%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
