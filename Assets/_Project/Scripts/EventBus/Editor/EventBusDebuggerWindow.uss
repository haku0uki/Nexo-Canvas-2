.event-bus-debugger {
    flex-grow: 1;
    padding: 8px;
}

.toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.toolbar-toggle {
    margin-right: 12px;
}

.tab-bar {
    flex-direction: row;
    margin-bottom: 8px;
}

.tab-button {
    margin-right: 4px;
    background-color: rgba(120, 120, 120, 0.12);
}

.tab-button--active {
    background-color: rgba(90, 140, 200, 0.35);
}

.history-line {
    padding: 3px 4px;
    color: rgb(200, 200, 200);
}

.play-mode-hint {
    white-space: normal;
    padding: 8px;
    background-color: rgba(120, 120, 60, 0.2);
    border-left-width: 3px;
    border-left-color: rgb(200, 180, 80);
}

.event-list {
    flex-grow: 1;
}

.event-row {
    margin-bottom: 2px;
    border-radius: 3px;
}

.event-row--idle {
    background-color: rgba(120, 120, 120, 0.12);
}

.event-row--low {
    background-color: rgba(90, 160, 90, 0.18);
}

.event-row--medium {
    background-color: rgba(180, 180, 80, 0.18);
}

.event-row--high {
    background-color: rgba(190, 90, 90, 0.18);
}

.binding-line {
    margin-left: 16px;
    color: rgb(190, 190, 190);
}

.raise-button {
    margin-left: 16px;
    margin-top: 2px;
    margin-bottom: 4px;
    align-self: flex-start;
}

.summary-label {
    margin-top: 8px;
    padding-top: 6px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.event-group-field-label {
    color: rgb(160, 160, 160);
    -unity-font-style: italic;
}
