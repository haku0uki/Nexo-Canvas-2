
<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:ScrollView name="profile-scroll" mode="Vertical">
    <ui:VisualElement
        name="profile-view-root"
        class="profile-root">

      <ui:VisualElement
          name="profile-avatar-drawing"
          class="profile-avatar" />

      <ui:Label
          name="profile-nickname-label"
          text="Usuario"
          class="profile-nickname" />

      <ui:Label
          name="profile-pronouns-label"
          class="profile-pronouns" />

      <ui:Label
          name="profile-email-label"
          class="profile-email" />

      <ui:Label
          name="profile-status-label"
          class="profile-status" />

      <ui:VisualElement class="profile-separator" />

      <ui:Label
          text="Publicaciones"
          class="profile-section-title" />

      <ui:VisualElement
          name="profile-posts-list"
          class="profile-posts-list" />

    </ui:VisualElement>
  </ui:ScrollView>
</ui:UXML>
