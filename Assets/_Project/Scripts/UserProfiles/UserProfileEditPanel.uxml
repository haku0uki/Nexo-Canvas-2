<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Scripts/UserProfiles/UserProfilePanels.uss?fileID=7433441132597879392&amp;guid=344c157ced2639d4d8d216198f00f7bc&amp;type=3#UserProfilePanels"/>
    <ui:VisualElement name="profile-edit-overlay" class="profile-edit-overlay" style="align-content: flex-start; background-color: rgba(0, 45, 77, 0.83); bottom: -12px;">
        <ui:VisualElement name="profile-edit-window" class="profile-edit-window" style="color: rgb(19, 19, 18); -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/NexoCanvasFuente-Regular.otf?fileID=12800000&amp;guid=c8d3790eab9c74a488ca8941f9eab3d5&amp;type=3#NexoCanvasFuente-Regular&quot;); font-size: 48%; top: 0%; bottom: 0%; left: 0%; right: 0%; width: 68%; height: 46%; max-width: initial; max-height: initial; align-items: stretch; align-self: center; padding-left: 5%; margin-right: 0; padding-right: 5%; align-content: flex-start; justify-content: space-around; background-color: rgba(234, 253, 32, 0); background-image: url(&quot;project://database/Assets/_Project/2D/Panel%20de%20dibujo.png?fileID=2800000&amp;guid=c9b470fe72293cd478ba0ef219786f99&amp;type=3#Panel de dibujo&quot;);">
            <ui:VisualElement class="profile-edit-header" style="top: 7%; bottom: 0%; margin-bottom: 28px;">
                <ui:Label text="Editar mi perfil" class="profile-edit-title" style="font-size: 130%; letter-spacing: -6px; -unity-text-outline-width: 1px; color: rgb(19, 19, 18);"/>
            </ui:VisualElement>
            <ui:VisualElement name="profile-avatar-drawing" class="profile-edit-avatar" style="width: 257px; height: 272px; min-width: auto; min-height: auto;">
                <ui:Button name="profile-change-drawing-button" text="" enable-rich-text="false" emoji-fallback-support="false" class="profile-change-drawing-button" style="bottom: 27px; right: 25px; left: 0%; background-image: url(&quot;project://database/Assets/_Project/2D/Boton%20de%20lapiz.png?fileID=219454448&amp;guid=e030ae35b350ec743898ba6adbcfee83&amp;type=3#Boton de lapiz_0&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.75); top: 27%; position: relative; border-top-color: rgba(149, 149, 149, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(20, 23, 29, 0); -unity-slice-type: sliced; -unity-background-scale-mode: scale-to-fit; width: 127%; height: 50%; min-height: auto; aspect-ratio: 1; align-items: center; align-self: center;"/>
            </ui:VisualElement>
            <ui:Label text="Nombre de usuario" class="profile-field-label" style="font-size: 100%;"/>
            <ui:TextField name="profile-nickname-field" max-length="25" password="false" class="profile-edit-text-field" style="height: 7%; width: 94%; align-self: center;"/>
            <ui:Label text="Pronombres" class="profile-field-label" style="font-size: 100%;"/>
            <ui:TextField name="profile-pronouns-field" max-length="15" class="profile-edit-text-field" style="height: 7%; width: 94%; align-self: center;"/>
            <ui:Label name="profile-status-label" text="" class="profile-status"/>
            <ui:VisualElement class="profile-edit-actions" style="align-self: flex-end; align-items: flex-end; bottom: 5%; width: 99%; height: 7%;">
                <ui:Button name="profile-cancel-button" text="" class="profile-cancel-button" style="min-height: 36%; border-top-color: rgba(149, 149, 149, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-image: url(&quot;project://database/Assets/_Project/2D/Boton%20Cancelar.png?fileID=-1312338684&amp;guid=93f7ddbbfd19f5d498f08a4fa517e253&amp;type=3#Boton Cancelar_0&quot;); background-color: rgba(188, 188, 188, 0); -unity-background-scale-mode: scale-to-fit; width: 35%; height: 110%;"/>
                <ui:Button name="profile-save-button" text="" class="profile-save-button" style="background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/_Project/2D/Boton%20Confirmar.png?fileID=-1941097173&amp;guid=8ec51c05a90b11c419ed34ddb43ef508&amp;type=3#Boton Confirmar_0&quot;); -unity-background-scale-mode: scale-to-fit; height: 110%; width: 35%; color: rgba(19, 19, 18, 0);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
